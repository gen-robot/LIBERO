(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language turn on the stove and put the butter on it)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.1900 -0.1900 0.2100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1750 -0.1150 -0.0650 -0.0450)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 0.0700 0.2650 0.2300)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3350 -0.0700 -0.2650 0.0700)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    butter_1 - butter
  )

  (:obj_of_interest
    butter_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_frypan_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On butter_1 kitchen_table_butter_init_region)
  )

  (:goal
    (And (Turnon flat_stove_1) (On butter_1 flat_stove_1_cook_region))
  )
)