(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language turn on the stove, put the moka pot on it, and put the butter on the plate)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.1900 -0.1900 0.2100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0250 -0.0250 0.0750 0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0550 -0.15 0.0550 -0.1)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3050 -0.0650 -0.1750 0.0650)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1550 0.1600 0.4450 0.3200)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
    butter_1 - butter
    plate_1 - plate
  )

  (:obj_of_interest
    moka_pot_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_frypan_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On butter_1 kitchen_table_butter_init_region)
    (On plate_1 kitchen_table_plate_init_region)
  )

  (:goal
    (And (Turnon flat_stove_1) (On moka_pot_1 flat_stove_1_cook_region) (On butter_1 plate_1))
  )
)