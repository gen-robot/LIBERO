(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl between the butter and the ketchup and place it on the plate)
    (:regions
      (plate_region
          (:target main_table)
          (:ranges (
              (0.0500 0.1900 0.0700 0.2100)
            )
          )
      )
      (next_to_plate_region
          (:target main_table)
          (:ranges (
              (0.0000 0.3000 0.0200 0.3200)
            )
          )
      )
      (box_region
          (:target main_table)
          (:ranges (
              (0.0600 0.0200 0.0800 0.0400)
            )
          )
      )
      (next_to_box_region
          (:target main_table)
          (:ranges (
              (0.1200 -0.0800 0.1400 -0.0600)
            )
          )
      )
      (ramekin_region
          (:target main_table)
          (:ranges (
              (-0.2100 0.1900 -0.1900 0.2100)
            )
          )
      )
      (next_to_ramekin_region
          (:target main_table)
          (:ranges (
              (0.05 -0.2 0.1 -0.1)
            )
          )
      )
      (table_center
          (:target main_table)
          (:ranges (
              (-0.1000 -0.0100 -0.0500 0.0100)
            )
          )
      )
      (table_front
          (:target main_table)
          (:ranges (
              (0.1900 -0.0100 0.2100 0.0100)
            )
          )
      )
      (cabinet_region
          (:target main_table)
          (:ranges (
              (0.0200 -0.2800 0.0400 -0.2600)
            )
          )
          (:yaw_rotation (
              (2.6613777765410678 2.7242096296128633)
            )
          )
      )
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.4200 -0.1500 -0.4000 -0.1300)
            )
          )
      )
      (butter_init_region
          (:target main_table)
          (:ranges (
              (-0.1350 -0.0350 -0.0250 0.0350)
            )
          )
      )
      (ketchup_init_region
          (:target main_table)
          (:ranges (
              (-0.3650 0.2150 -0.2950 0.3250)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target main_table)
          (:ranges (
              (-0.27 0.14 -0.24 0.17)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 - akita_black_bowl
    plate_1 - plate
    butter_1 - butter
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    akita_black_bowl_1
    butter_1
    ketchup_1
  )

  (:init
    (On akita_black_bowl_2 main_table_next_to_ramekin_region)
    (On plate_1 main_table_plate_region)
    (On butter_1 main_table_butter_init_region)
    (On ketchup_1 main_table_ketchup_init_region)
    (On akita_black_bowl_1 main_table_akita_black_bowl_init_region)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )
)