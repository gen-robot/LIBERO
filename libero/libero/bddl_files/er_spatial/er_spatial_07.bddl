(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the tomato sauce next to the book and put it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0100 0.2500 0.0100 0.2700)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_init_region
          (:target living_room_table)
          (:ranges (
              (0.0250 -0.1250 0.0750 -0.0750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1750 0.0350 -0.1250 0.0850)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2250 -0.1750 -0.1750 -0.1250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (black_book_landmark_point
          (:target living_room_table)
          (:ranges (
              (-0.0001 0.0499 0.0001 0.0501)
            )
          )
      )
      (tomato_sauce_a1_point
          (:target living_room_table)
          (:ranges (
              (0.0999 0.0499 0.1001 0.0501)
            )
          )
      )
      (tomato_sauce_a2_point
          (:target living_room_table)
          (:ranges (
              (-0.1801 -0.1801 -0.1799 -0.1799)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    tomato_sauce_1 tomato_sauce_2 - tomato_sauce
    basket_1 - basket
    black_book_1 - black_book
  )

  (:obj_of_interest
    tomato_sauce_1
    black_book_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On black_book_1 living_room_table_black_book_landmark_point)
    (On tomato_sauce_1 living_room_table_tomato_sauce_a1_point)
    (On tomato_sauce_2 living_room_table_tomato_sauce_a2_point)
  )

  (:goal
    (And (In tomato_sauce_1 basket_1_contain_region))
  )
)