(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the cream cheese to the right of the bowl and put it on the cabinet)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 -0.3100 0.0100 -0.2900)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 0.2250 0.0250 0.2750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target wooden_cabinet_1)
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (akita_black_bowl_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2200 -0.1900 -0.0800 -0.0500)
            )
          )
      )
      (cream_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0150 -0.1450 0.0550 -0.0950)
            )
          )
      )
      (milk_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1800 0.0700 -0.1200 0.1700)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    cream_cheese_1 - cream_cheese
    milk_1 - milk
  )

  (:obj_of_interest
    cream_cheese_1
    wooden_cabinet_1_top_side
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_init_region)
    (On milk_1 kitchen_table_milk_init_region)
  )

  (:goal
    (And (On cream_cheese_1 wooden_cabinet_1_top_side))
  )
)