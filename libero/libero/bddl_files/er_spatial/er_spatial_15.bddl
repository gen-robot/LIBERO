      )
      (salad_dressing_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.0400 0.02 0.0400 0.08)
            )
          )
      )
      (salad_dressing_init_region_2
          (:target kitchen_table)
          (:ranges (
              (-0.3100 -0.1350 -0.2300 -0.08)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
