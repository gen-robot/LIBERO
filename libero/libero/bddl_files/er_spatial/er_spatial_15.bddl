    (On salad_dressing_1 kitchen_table_salad_dressing_init_region_1)
    (On salad_dressing_2 kitchen_table_salad_dressing_init_region_2)
    (On plate_1 kitchen_table_plate_init_region)
    (On basket_1 kitchen_table_basket_init_region)
    (On black_book_distractor kitchen_table_black_book_init_region)
  )

  (:goal
