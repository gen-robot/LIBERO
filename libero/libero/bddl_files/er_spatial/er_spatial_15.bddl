  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    chefmate_8_frypan_1 - chefmate_8_frypan
    salad_dressing_1 salad_dressing_2 - salad_dressing
    plate_1 - plate
    basket_1 - basket
    black_book_distractor - black_book
  )

  (:obj_of_interest
    salad_dressing_1
    chefmate_8_frypan_1
  )

  (:init
