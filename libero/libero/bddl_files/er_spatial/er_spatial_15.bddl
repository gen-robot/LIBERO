(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the salad dressing next to the frying pan and put it in the basket)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.2900 -0.1900 0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
