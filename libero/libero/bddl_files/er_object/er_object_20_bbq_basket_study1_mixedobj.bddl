          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_init_region
          (:target study_table)
          (:ranges (
              (-0.22 0.06999999999999999 -0.18000000000000002 0.11)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
