(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the orange juice and place it in the basket)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_rack_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.11 -0.31 -0.09000000000000001 -0.29)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target wine_rack_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.11 -0.15000000000000002 0.11 0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (orange_juice_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.23 0.03 -0.17 0.13)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (black_book_init_region
          (:target kitchen_table)
          (:ranges (
              (0.09 0.09999999999999999 0.21 0.13999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
    wine_rack_1 - wine_rack
  )

  (:objects
    basket_1 - basket
    orange_juice_1 - orange_juice
    black_book_1 - black_book
  )

  (:obj_of_interest
    orange_juice_1
    basket_1
  )

  (:init
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On wine_rack_1 kitchen_table_wine_rack_init_region)
    (On basket_1 kitchen_table_basket_init_region)
    (On orange_juice_1 kitchen_table_orange_juice_init_region)
    (On black_book_1 kitchen_table_black_book_init_region)
  )

  (:goal
    (And (In orange_juice_1 basket_1_contain_region))
  )

)