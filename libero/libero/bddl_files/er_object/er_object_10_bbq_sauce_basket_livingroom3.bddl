(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bbq sauce and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.09 0.09 0.09 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (bbq_sauce_init_region
          (:target living_room_table)
          (:ranges (
              (-0.025 -0.125 0.025 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On bbq_sauce_1 living_room_table_bbq_sauce_init_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)