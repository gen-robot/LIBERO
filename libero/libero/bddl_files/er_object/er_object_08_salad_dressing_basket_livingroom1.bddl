(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the salad dressing and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.09 0.09 0.09 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (salad_dressing_init_region
          (:target living_room_table)
          (:ranges (
              (-0.025 -0.125 0.025 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On salad_dressing_1 living_room_table_salad_dressing_init_region)
  )

  (:goal
    (And (In salad_dressing_1 basket_1_contain_region))
  )

)