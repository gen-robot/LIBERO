(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the milk and place it in the basket)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 0.29 0.01 0.31)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.165 -0.305 -0.08 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (milk_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2 0.02 0.02 0.15)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.06500000000000003 -0.25 0.13500000000000004 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (0.2 0.05 0.25 0.055)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    basket_1 - basket
    milk_1 - milk
    moka_pot_1 - moka_pot
    chefmate_8_frypan_1 - chefmate_8_frypan
  )

  (:obj_of_interest
    milk_1
    basket_1
  )

  (:init
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On basket_1 kitchen_table_basket_init_region)
    (On milk_1 kitchen_table_milk_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On chefmate_8_frypan_1 kitchen_table_chefmate_8_frypan_init_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region))
  )

)