(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the chocolate pudding and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.11 0.07999999999999999 0.11 0.28)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (chocolate_pudding_init_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.13 0.03 -0.07)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target living_room_table)
          (:ranges (
              (-0.24 -0.11 -0.12 0.009999999999999995)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_init_region
          (:target living_room_table)
          (:ranges (
              (0.13 -0.1 0.22999999999999998 0.0)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On chocolate_pudding_1 living_room_table_chocolate_pudding_init_region)
    (On plate_1 living_room_table_plate_init_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_glazed_rim_porcelain_ramekin_init_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)