(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the chocolate pudding and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.09 0.09 0.09 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (chocolate_pudding_init_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.13 0.03 -0.07)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target living_room_table)
          (:ranges (
              (-0.25 -0.12000000000000001 -0.10999999999999999 0.020000000000000004)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_init_region
          (:target living_room_table)
          (:ranges (
              (0.13999999999999999 -0.09 0.22 -0.010000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
    plate_1 - plate
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On chocolate_pudding_1 living_room_table_chocolate_pudding_init_region)
    (On plate_1 living_room_table_plate_init_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_glazed_rim_porcelain_ramekin_init_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)