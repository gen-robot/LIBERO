(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the cream cheese and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.165 -0.02 0.165 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (cream_cheese_init_region
          (:target living_room_table)
          (:ranges (
              (-0.049999999999999996 -0.19 0.049999999999999996 -0.10999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    cream_cheese_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On cream_cheese_1 living_room_table_cream_cheese_init_region)
  )

  (:goal
    (And (In cream_cheese_1 basket_1_contain_region))
  )

)