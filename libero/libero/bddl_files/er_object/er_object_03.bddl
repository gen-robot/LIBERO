(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the ketchup and place it in the basket)
    (:regions
      (desk_caddy_init_region
          (:target study_table)
          (:ranges (
              (-0.21000000000000002 -0.15000000000000002 -0.19 -0.13)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (desk_caddy_right_region
          (:target study_table)
          (:ranges (
              (-0.25 0.09999999999999999 -0.15000000000000002 0.2)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (right_contain_region
          (:target desk_caddy_1)
      )
      (left_contain_region
          (:target desk_caddy_1)
      )
      (back_contain_region
          (:target desk_caddy_1)
      )
      (front_contain_region
          (:target desk_caddy_1)
      )
      (basket_init_region
          (:target study_table)
          (:ranges (
              (-0.265 -0.185 0.065 0.125)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (ketchup_init_region
          (:target study_table)
          (:ranges (
              (0.06500000000000003 -0.085 0.13500000000000004 0.025000000000000005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    desk_caddy_1 - desk_caddy
  )

  (:objects
    basket_1 - basket
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On desk_caddy_1 study_table_desk_caddy_init_region)
    (On basket_1 study_table_basket_init_region)
    (On ketchup_1 study_table_ketchup_init_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)