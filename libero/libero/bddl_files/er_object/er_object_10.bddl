(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bbq sauce and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.165 -0.034999999999999996 0.165 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (bbq_sauce_init_region
          (:target living_room_table)
          (:ranges (
              (-0.04 -0.20500000000000002 0.04 -0.09499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target living_room_table)
          (:ranges (
              (0.06500000000000003 -0.22 0.13500000000000004 -0.07999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target living_room_table)
          (:ranges (
              (0.055 -0.22999999999999998 0.34500000000000003 -0.06999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
    moka_pot_1 - moka_pot
    chefmate_8_frypan_1 - chefmate_8_frypan
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On bbq_sauce_1 living_room_table_bbq_sauce_init_region)
    (On moka_pot_1 living_room_table_moka_pot_init_region)
    (On chefmate_8_frypan_1 living_room_table_chefmate_8_frypan_init_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)