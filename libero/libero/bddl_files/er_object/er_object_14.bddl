(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the ketchup and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.165 0.1 0.15 0.255)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (ketchup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.18 -0.18 0.075 0.015000000000000003)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cookies_init_region
          (:target living_room_table)
          (:ranges (
              (0.115 -0.2 0.203 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_init_region
          (:target living_room_table)
          (:ranges (
              (0.1 -0.01 0.204 0.01)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    ketchup_1 - ketchup
    cookies_1 - cookies
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On ketchup_1 living_room_table_ketchup_init_region)
    (On cookies_1 living_room_table_cookies_init_region)
    (On glazed_rim_porcelain_ramekin_1 living_room_table_glazed_rim_porcelain_ramekin_init_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)