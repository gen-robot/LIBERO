(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the milk and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.165 -0.034999999999999996 0.165 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (milk_init_region
          (:target living_room_table)
          (:ranges (
              (-0.045 -0.215 0.045 -0.08499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    milk_1 - milk
  )

  (:obj_of_interest
    milk_1
    basket_1
  )

  (:init
    (On basket_1 living_room_table_basket_init_region)
    (On milk_1 living_room_table_milk_init_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region))
  )

)