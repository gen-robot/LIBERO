(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the orange juice and place it in the basket)
    (:regions
      (wine_rack_region
          (:target main_table)
          (:ranges (
              (-0.27 -0.27 -0.25 -0.25)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (top_region
          (:target wine_rack_1)
      )
      (basket_init_region
          (:target main_table)
          (:ranges (
              (0.055 -0.205 0.25 0.005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (orange_juice_init_region
          (:target main_table)
          (:ranges (
              (-0.195 0.015000000000000003 -0.10499999999999998 0.14500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
    wine_rack_1 - wine_rack
  )

  (:objects
    basket_1 - basket
    orange_juice_1 - orange_juice
  )

  (:obj_of_interest
    orange_juice_1
    basket_1
  )

  (:init
    (On wine_rack_1 main_table_wine_rack_region)
    (On basket_1 main_table_basket_init_region)
    (On orange_juice_1 main_table_orange_juice_init_region)
  )

  (:goal
    (And (In orange_juice_1 basket_1_contain_region))
  )

)
