(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the ketchup and place it in the basket)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 -0.31 0.01 -0.29)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (top_side
          (:target wooden_cabinet_1)
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.09 0.09 0.09 0.27)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.025 -0.125 0.025 -0.07500000000000001)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.22 -0.09 -0.13999999999999999 -0.010000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_init_region
          (:target kitchen_table)
          (:ranges (
              (0.15 -0.08 0.21 -0.020000000000000004)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    basket_1 - basket
    ketchup_1 - ketchup
    moka_pot_1 - moka_pot
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

  (:init
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On basket_1 kitchen_table_basket_init_region)
    (On ketchup_1 kitchen_table_ketchup_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On wine_bottle_1 kitchen_table_wine_bottle_init_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)