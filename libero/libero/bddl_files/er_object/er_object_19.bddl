(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the chocolate pudding and place it in the basket)
    (:regions
      (basket_init_region
          (:target main_table)
          (:ranges (
              (-0.165 0.034999999999999996 0.165 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (chocolate_pudding_init_region
          (:target main_table)
          (:ranges (
              (-0.3 -0.3 0.045 -0.01)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_init_region
          (:target main_table)
          (:ranges (
              (0.05 -0.25 0.15000000000000002 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_1
  )

  (:init
    (On basket_1 main_table_basket_init_region)
    (On chocolate_pudding_1 main_table_chocolate_pudding_init_region)
    (On cream_cheese_1 main_table_cream_cheese_init_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region))
  )

)
