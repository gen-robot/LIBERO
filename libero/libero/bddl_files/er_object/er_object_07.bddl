(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the cream cheese and place it in the basket)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21000000000000002 0.19 -0.19 0.21000000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.165 -0.305 0.165 0.005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (cream_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (0.15000000000000002 -0.19 0.25 -0.10999999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.225 -0.055 -0.17500000000000002 -0.004999999999999998)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    basket_1 - basket
    cream_cheese_1 - cream_cheese
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    cream_cheese_1
    basket_1
  )

  (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On basket_1 kitchen_table_basket_init_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_init_region)
    (On wine_bottle_1 kitchen_table_wine_bottle_init_region)
  )

  (:goal
    (And (In cream_cheese_1 basket_1_contain_region))
  )

)