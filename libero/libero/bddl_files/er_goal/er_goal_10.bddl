(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bbq sauce on top of the cabinet)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 -0.3100 0.0100 -0.2900)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 0.2250 0.0250 0.2750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target wooden_cabinet_1)
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (bbq_sauce_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0800 0.0950 0.1600 0.2050)
            )
          )
      )
      (wooden_tray_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0850 -0.0050 0.3250 0.3050)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    wooden_tray_1 - wooden_tray
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On bbq_sauce_1 kitchen_table_bbq_sauce_init_region)
    (On wooden_tray_1 kitchen_table_wooden_tray_init_region)
  )

  (:goal
    (And (On bbq_sauce_1 wooden_cabinet_1_top_side))
  )
)