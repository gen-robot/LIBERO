(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bbq sauce on the cabinet)
    (:regions
      (wooden_two_layer_shelf_init_region
          (:target study_table)
          (:ranges (
              (-0.0100 0.2700 0.0100 0.2900)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (top_region
          (:target wooden_two_layer_shelf_1)
      )
      (bottom_region
          (:target wooden_two_layer_shelf_1)
      )
      (bbq_sauce_init_region
          (:target study_table)
          (:ranges (
              (-0.0400 0.0950 0.0400 0.2050)
            )
          )
      )
      (moka_pot_init_region
          (:target study_table)
          (:ranges (
              (-0.1550 0.0800 -0.0850 0.2200)
            )
          )
      )
      (moka_pot_init_region_1
          (:target study_table)
          (:ranges (
              (0.0450 -0.0700 0.1150 0.0700)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    bbq_sauce_1 - bbq_sauce
    moka_pot_1 moka_pot_2 - moka_pot
  )

  (:obj_of_interest
    bbq_sauce_1
  )

  (:init
    (On wooden_two_layer_shelf_1 study_table_wooden_two_layer_shelf_init_region)
    (On bbq_sauce_1 study_table_bbq_sauce_init_region)
    (On moka_pot_1 study_table_moka_pot_init_region)
    (On moka_pot_2 study_table_moka_pot_init_region_1)
  )

  (:goal
    (And (On bbq_sauce_1 wooden_two_layer_shelf_1_top_side))
  )
)