          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.2900 -0.1900 0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
          (:target kitchen_table)
          (:ranges (
