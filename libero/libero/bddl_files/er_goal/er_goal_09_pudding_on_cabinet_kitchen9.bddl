            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0250 -0.0250 0.0750 0.0250)
            )
          )
          (:yaw_rotation (
