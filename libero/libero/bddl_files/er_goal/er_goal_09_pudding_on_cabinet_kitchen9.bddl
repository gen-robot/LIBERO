            )
          )
      )
      (white_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1750 0.0750 -0.1250 0.1250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
