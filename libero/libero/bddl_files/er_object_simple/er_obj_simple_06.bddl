(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the black book and place it in the basket)
    (:regions
      (bin_region
          (:target living_room_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target living_room_table)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_0
          (:target living_room_table)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
      (other_object_region_1
          (:target living_room_table)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
      )
      (other_object_region_2
          (:target living_room_table)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
      )
      (other_object_region_3
          (:target living_room_table)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
      )
      (other_object_region_4
          (:target living_room_table)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    black_book_1 - butter
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
    moka_pot_1 - moka_pot
    white_yellow_mug_1 - white_yellow_mug
    plate_1 - plate
    akita_black_bowl_1 - akita_black_bowl
  )

  (:obj_of_interest
    black_book_1
    basket_1
  )

  (:init
    (On black_book_1 living_room_table_target_object_region)
    (On tomato_sauce_1 living_room_table_other_object_region_0)
    (On moka_pot_1 living_room_table_other_object_region_1)
    (On white_yellow_mug_1 living_room_table_other_object_region_2)
    (On plate_1 living_room_table_other_object_region_3)
    (On akita_black_bowl_1 living_room_table_other_object_region_4)
    (On basket_1 living_room_table_bin_region)
  )

  (:goal
    (And (In black_book_1 basket_1_contain_region))
  )

)
