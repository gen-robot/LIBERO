(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bowl on the plate, put the butter on the plate, and put the ketchup on the cabinet)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 -0.3100 0.0100 -0.2900)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 -0.0250 0.0250 0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target wooden_cabinet_1)
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0550 0.1150 0.0550 0.1850)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2150 0.1850 -0.1450 0.2950)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3050 -0.0650 -0.1750 0.0650)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    butter_1 - butter
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    butter_1
  )

    (:init
    (On plate_1 kitchen_table_plate_init_region)
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On akita_black_bowl_1 plate_1)
    (On butter_1 plate_1)
    (On ketchup_1 wooden_cabinet_1_top_side)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1) (On butter_1 plate_1) (On ketchup_1 wooden_cabinet_1_top_side))
  )
)