(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine on the rack, put the butter on the cabinet, and put the bowl on the plate)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 0.2900 0.0100 0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_rack_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1100 -0.3100 -0.0900 -0.2900)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0050 -0.0750 0.0550 -0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wine_bottle_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1750 0.0250 -0.1250 0.0750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1900 -0.1400 -0.1100 -0.1000)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.1400 -0.0900 0.2600)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
    wine_rack_1 - wine_rack
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    wine_bottle_1 - wine_bottle
    butter_1 - butter
    plate_1 - plate
  )

  (:obj_of_interest
    wine_bottle_1
    butter_1
    akita_black_bowl_1
    plate_1
  )

    (:init
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On wine_rack_1 kitchen_table_wine_rack_init_region)
    (Open white_cabinet_1_bottom_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On wine_bottle_1 wine_rack_1)
    (On butter_1 white_cabinet_1_top_side)
    (On akita_black_bowl_1 plate_1)
  )

  (:goal
    (And (On wine_bottle_1 wine_rack_1) (On butter_1 white_cabinet_1_top_side) (On akita_black_bowl_1 plate_1))
  )
)