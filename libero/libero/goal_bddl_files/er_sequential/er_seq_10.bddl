(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the pudding in the basket, put the butter in the basket, and put the tomato sauce in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0100 0.2500 0.0100 0.2700)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1250 0.0250 -0.0750 0.0750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (butter_init_region
          (:target living_room_table)
          (:ranges (
              (0.0250 0.0250 0.0750 0.0750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (contain_region_1
          (:target basket_1)
      )
      (chocolate_pudding_init_region
          (:target living_room_table)
          (:ranges (
              (0.145 -0.12 0.175 -0.08)
            )
          )
      )
      (orange_juice_init_region
          (:target living_room_table)
          (:ranges (
              (-0.150 -0.2050 -0.1 -0.150)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    tomato_sauce_1 - tomato_sauce
    orange_juice_1 - orange_juice
    butter_1 - butter
    basket_1 - basket
    chocolate_pudding_1 - chocolate_pudding
  )

  (:obj_of_interest
    chocolate_pudding_1
    basket_1
  )

    (:init
    (On orange_juice_1 living_room_table_orange_juice_init_region)
    (On basket_1 living_room_table_basket_init_region)
    (On chocolate_pudding_1 basket_1_contain_region)
    (On butter_1 basket_1_contain_region)
    (On tomato_sauce_1 basket_1_contain_region)
  )

  (:goal
    (And (In chocolate_pudding_1 basket_1_contain_region) (In butter_1 basket_1_contain_region) (In tomato_sauce_1 basket_1_contain_region))
  )
)