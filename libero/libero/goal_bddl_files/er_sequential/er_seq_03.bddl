(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the cream cheese on the plate and close the drawer)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 0.2900 0.0100 0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (cream_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2000 -0.15 -0.1000 -0.1)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0950 0.01 0.1150 0.0550)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (0.17 0.1650 0.21 0.21)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (0.01 -0.15 0.11 -0.1)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    ketchup_1 - ketchup
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    cream_cheese_1
  )

    (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On ketchup_1 kitchen_table_ketchup_init_region)
    (On cream_cheese_1 plate_1)
    (Close white_cabinet_1_top_region)
  )

  (:goal
    (And (On cream_cheese_1 plate_1) (Close white_cabinet_1_top_region))
  )
)