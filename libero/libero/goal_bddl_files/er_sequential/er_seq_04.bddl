(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the milk in the basket, then put the ketchup in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0100 0.2500 0.0100 0.2700)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (alphabet_soup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0450 0.0350 0.0450 0.1250)
            )
          )
      )
      (butter_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1750 -0.1150 -0.0650 -0.0450)
            )
          )
      )
      (milk_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2250 0.1750 -0.1350 0.3050)
            )
          )
      )
      (ketchup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.3350 -0.0550 -0.2650 0.0550)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    ketchup_1 - ketchup
    milk_1 - milk
    butter_1 - butter
    basket_1 - basket
  )

  (:obj_of_interest
    ketchup_1
  )

    (:init
    (On alphabet_soup_1 living_room_table_alphabet_soup_init_region)
    (On butter_1 living_room_table_butter_init_region)
    (On basket_1 living_room_table_basket_init_region)
    (On milk_1 basket_1_contain_region)
    (On ketchup_1 basket_1_contain_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region) (In ketchup_1 basket_1_contain_region))
  )
)