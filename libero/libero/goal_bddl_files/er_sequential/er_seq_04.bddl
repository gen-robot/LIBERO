(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the bowl on the stove and put the butter on the plate)
    (:regions
      (stove_front_region
          (:target main_table)
          (:ranges (
              (-0.0900 0.1700 -0.0100 0.2500)
            )
          )
      )
      (cabinet_region
          (:target main_table)
          (:ranges (
              (0.0200 -0.2500 0.0400 -0.2300)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.4200 0.2000 -0.4000 0.2200)
            )
          )
      )
      (wine_rack_region
          (:target main_table)
          (:ranges (
              (-0.2700 -0.2700 -0.2500 -0.2500)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (top_side
          (:target wooden_cabinet_1)
      )
      (cook_region
          (:target flat_stove_1)
      )
      (right_region
          (:target bowl_drainer_1)
      )
      (left_region
          (:target bowl_drainer_1)
      )
      (butter_init_region
          (:target main_table)
          (:ranges (
              (-0.0550 0.1150 0.0550 0.1850)
            )
          )
      )
      (wine_bottle_init_region
          (:target main_table)
          (:ranges (
              (-0.1050 -0.0250 -0.0550 0.0250)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target main_table)
          (:ranges (
              (0.1150 -0.1 0.150 0.0)
            )
          )
      )
      (plate_init_region
          (:target main_table)
          (:ranges (
              (-0.2 -0.1 -0.1 0)
            )
          )
      )
      (cream_cheese_init_region
          (:target main_table)
          (:ranges (
              (0.0400 -0.0700 0.1400 0.0100)
            )
          )
      )
    )

  (:fixtures
    main_table - table
    wooden_cabinet_1 - wooden_cabinet
    flat_stove_1 - flat_stove
    wine_rack_1 - wine_rack
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    wine_bottle_1 - wine_bottle
    plate_1 - plate
    butter_1 - butter
  )

  (:obj_of_interest
    butter_1
  )

    (:init
    (On wine_bottle_1 main_table_wine_bottle_region)
    (On plate_1 main_table_plate_init_region)
    (On cream_cheese_1 main_table_cream_cheese_region)
    (On wooden_cabinet_1 main_table_cabinet_region)
    (On flat_stove_1 main_table_stove_region)
    (On wine_rack_1 main_table_wine_rack_region)
    (On akita_black_bowl_1 flat_stove_1_cook_region)
    (On butter_1 plate_1)
  )

  (:goal
    (And (On akita_black_bowl_1 flat_stove_1_cook_region) (On butter_1 plate_1))
  )
)