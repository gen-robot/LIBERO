  (:objects
    akita_black_bowl_1 akita_black_bowl_2 - akita_black_bowl
    plate_1 - plate
    orange_juice_1 - orange_juice
    white_yellow_mug_1 - white_yellow_mug
    black_book_1 - black_book
  )

  (:obj_of_interest
    akita_black_bowl_1
    orange_juice_1
  )

    (:init
    (On orange_juice_1 main_table_orange_juice_init_region_1)
    (On plate_1 main_table_plate_support_point)
    (On akita_black_bowl_2 main_table_akita_black_bowl_a2_point)
    (On white_yellow_mug_1 main_table_white_yellow_mug_init_region)
    (On black_book_1 main_table_black_book_init_region)
    (On akita_black_bowl_1 plate_1)
