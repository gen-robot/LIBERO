(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the salad dressing next to the butter and put it in the basket)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.2900 -0.1900 0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (wooden_two_layer_shelf_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 -0.2600 0.0100 -0.2400)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0250 -0.0250 0.0750 0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (white_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1750 0.0750 -0.1250 0.1250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (salad_dressing_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0400 0.1850 0.0400 0.2950)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.250 0.0850 -0.1 0.20)
            )
          )
      )
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1750 -0.1150 -0.0650 -0.0450)
            )
          )
      )
      (butter_landmark_point
          (:target kitchen_table)
          (:ranges (
              (0.1499 -0.1501 0.1501 -0.1499)
            )
          )
      )
      (salad_dressing_a1_point
          (:target kitchen_table)
          (:ranges (
              (0.0999 -0.0001 0.1001 0.0001)
            )
          )
      )
      (salad_dressing_a2_point
          (:target kitchen_table)
          (:ranges (
              (-0.1801 -0.1801 -0.1799 -0.1799)
            )
          )
      )
      (butter_init_region_1
          (:target kitchen_table)
          (:ranges (
              (-0.2050 0.0450 -0.0950 0.1150)
            )          )
      )  ; NOTE: region kept for backward-compatibility but not used in init
    )

  (:fixtures
    kitchen_table - kitchen_table
  )

  (:objects
    salad_dressing_1 salad_dressing_2 - salad_dressing
    basket_1 - basket
    butter_1 - butter
  )

  (:obj_of_interest
    salad_dressing_1
    butter_1
  )

    (:init
    (On butter_1 kitchen_table_butter_landmark_point)
    (On salad_dressing_2 kitchen_table_salad_dressing_a2_point)
    (On basket_1 kitchen_table_basket_init_region)
    (On salad_dressing_1 basket_1_contain_region)
  )

  (:goal
    (And (In salad_dressing_1 basket_1_contain_region))
  )
)
