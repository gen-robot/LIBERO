(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the black bowl next to the cream cheese and place it on the plate)
    (:regions
      (next_to_plate_region
          (:target main_table)
          (:ranges (
              (0.0000 0.3000 0.0200 0.3200)
            )
          )
      )
      (box_region
          (:target main_table)
          (:ranges (
              (0.0600 0.0200 0.0800 0.0400)
            )
          )
      )
      (between_plate_ramekin_region
          (:target main_table)
          (:ranges (
              (-0.0600 0.1900 -0.0400 0.2100)
            )
          )
      )
      (ramekin_region
          (:target main_table)
          (:ranges (
              (-0.2100 0.1900 -0.1900 0.2100)
            )
          )
      )
      (next_to_ramekin_region
          (:target main_table)
          (:ranges (
              (-0.1900 0.3100 -0.1700 0.3300)
            )
          )
      )
      (table_center
          (:target main_table)
          (:ranges (
              (-0.1000 -0.0100 -0.0500 0.0100)
            )
          )
      )
      (table_front
          (:target main_table)
          (:ranges (
              (0.1900 -0.0100 0.2100 0.0100)
            )
          )
      )
      (cabinet_region
          (:target main_table)
          (:ranges (
              (0.0200 -0.2800 0.0400 -0.2600)
            )
          )
          (:yaw_rotation (
              (2.6613777765410678 2.7242096296128633)
            )
          )
      )
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.4200 -0.1500 -0.4000 -0.1300)
            )
          )
      )
      (cream_cheese_landmark_point
          (:target main_table)
          (:ranges (
              (-0.0001 0.0499 0.0001 0.0501)
            )
          )
      )
      (plate_support_point
          (:target main_table)
          (:ranges (
              (0.1799 -0.1801 0.1801 -0.1799)
            )
          )
      )
      (akita_black_bowl_a1_point
          (:target main_table)
          (:ranges (
              (0.0999 0.0499 0.1001 0.0501)
            )
          )
      )
      (akita_black_bowl_a2_point
          (:target main_table)
          (:ranges (
              (-0.1801 -0.1801 -0.1799 -0.1799)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    akita_black_bowl_1 akita_black_bowl_2 - akita_black_bowl
    plate_1 - plate
    cream_cheese_1 - cream_cheese
  )

  (:obj_of_interest
    akita_black_bowl_1
    cream_cheese_1
  )

    (:init
    (On cream_cheese_1 main_table_cream_cheese_landmark_point)
    (On plate_1 main_table_plate_support_point)
    (On akita_black_bowl_2 main_table_akita_black_bowl_a2_point)
    (On akita_black_bowl_1 plate_1)
  )

  (:goal
    (And (On akita_black_bowl_1 plate_1))
  )
)