(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the milk to the right of the cream cheese and put it on the cabinet)
    (:regions
      (white_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0100 0.2900 0.0100 0.3100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0050 -0.0750 0.0550 -0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1250 -0.1250 -0.0750 -0.0750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0750 -0.2750 -0.0250 -0.2250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target white_cabinet_1)
      )
      (top_region
          (:target white_cabinet_1)
      )
      (middle_region
          (:target white_cabinet_1)
      )
      (bottom_region
          (:target white_cabinet_1)
      )
      (cream_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1850 0.0150 -0.1150 0.0650)
            )
          )
      )
      (milk_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0600 0.0400 0.0000 0.1400)
            )
          )
      )
      (butter_init_region
          (:target kitchen_table)
          (:ranges (
              (0.1100 -0.1400 0.1900 -0.1000)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
    ketchup_1 - ketchup
    milk_1 - milk
    cream_cheese_1 - cream_cheese
    butter_1 - butter
  )

  (:obj_of_interest
    milk_1
    white_cabinet_1_top_side
  )

    (:init
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On ketchup_1 kitchen_table_ketchup_init_region)
    (Open white_cabinet_1_top_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_init_region)
    (On butter_1 kitchen_table_butter_init_region)
    (On milk_1 white_cabinet_1_top_side)
  )

  (:goal
    (And (On milk_1 white_cabinet_1_top_side))
  )
)