(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the ketchup next to the moka pot and put it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.0100 0.2500 0.0100 0.2700)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (alphabet_soup_init_region
          (:target living_room_table)
          (:ranges (
              (0.0250 -0.1250 0.0750 -0.0750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cream_cheese_init_region
          (:target living_room_table)
          (:ranges (
              (-0.1750 0.0350 -0.1250 0.0850)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (tomato_sauce_init_region
          (:target living_room_table)
          (:ranges (
              (0.0750 -0.2250 0.1250 -0.1750)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (moka_pot_landmark_point
          (:target living_room_table)
          (:ranges (
              (-0.0001 0.0499 0.0001 0.0501)
            )
          )
      )
      (ketchup_a1_point
          (:target living_room_table)
          (:ranges (
              (0.13 -0.11 0.16 -0.08)
            )
          )
      )
      (ketchup_a2_point
          (:target living_room_table)
          (:ranges (
              (-0.1801 -0.1801 -0.1799 -0.1799)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    ketchup_1 ketchup_2 - ketchup
    basket_1 - basket
    moka_pot_1 - moka_pot
  )

  (:obj_of_interest
    ketchup_1
    moka_pot_1
  )

    (:init
    (On basket_1 living_room_table_basket_init_region)
    (On moka_pot_1 living_room_table_moka_pot_landmark_point)
    (On ketchup_2 living_room_table_ketchup_a2_point)
    (On ketchup_1 basket_1_contain_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )
)