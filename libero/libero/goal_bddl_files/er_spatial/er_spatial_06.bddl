  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    milk_1 milk_2 - milk
    basket_1 - basket
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    milk_1
    wine_bottle_1
  )

    (:init
    (On basket_1 living_room_table_basket_init_region)
    (On wine_bottle_1 living_room_table_wine_bottle_landmark_point)
    (On milk_2 living_room_table_milk_a2_point)
    (On milk_1 basket_1_contain_region)
  )

  (:goal
