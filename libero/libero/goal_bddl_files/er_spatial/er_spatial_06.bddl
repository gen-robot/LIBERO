      )
      (ketchup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.2750 -0.1750 -0.2250 -0.1250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (wine_bottle_landmark_point
          (:target living_room_table)
          (:ranges (
              (-0.0001 0.0499 0.0001 0.0501)
