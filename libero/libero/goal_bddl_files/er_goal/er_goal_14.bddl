          (:target kitchen_table)
          (:ranges (
              (-0.0100 -0.2600 0.0100 -0.2400)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (top_region
          (:target wooden_two_layer_shelf_1)
      )
      (bottom_region
          (:target wooden_two_layer_shelf_1)
      )
      (milk_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0450 0.0850 0.0450 0.2150)
            )
          )
      )
      (porcelain_mug_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2350 0.0150 -0.0650 0.1450)
            )
          )
      )
      (red_coffee_mug_init_region
          (:target kitchen_table)
          (:ranges (
