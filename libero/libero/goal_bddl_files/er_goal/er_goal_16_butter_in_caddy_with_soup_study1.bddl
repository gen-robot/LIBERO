(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the butter in the caddy)
    (:regions
      (desk_caddy_init_region
          (:target study_table)
          (:ranges (
              (-0.2100 -0.1500 -0.1900 -0.1300)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (black_book_init_region
          (:target study_table)
          (:ranges (
              (-0.0250 0.1250 0.0250 0.1750)
            )
          )
          (:yaw_rotation (
              (-1.5707963267948966 -0.7853981633974483)
            )
          )
      )
      (white_yellow_mug_init_region
          (:target study_table)
          (:ranges (
              (0.0750 -0.0250 0.1250 0.0250)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (desk_caddy_right_region
          (:target study_table)
          (:ranges (
              (-0.2500 0.1000 -0.1500 0.2000)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (right_contain_region
          (:target desk_caddy_1)
      )
      (left_contain_region
          (:target desk_caddy_1)
      )
      (back_contain_region
          (:target desk_caddy_1)
      )
      (front_contain_region
          (:target desk_caddy_1)
      )
      (butter_init_region
          (:target study_table)
          (:ranges (
              (-0.1900 -0.0600 -0.1100 -0.0200)
            )
          )
      )
      (alphabet_soup_init_region
          (:target study_table)
          (:ranges (
              (-0.0300 -0.1500 0.0300 -0.0900)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    desk_caddy_1 - desk_caddy
  )

  (:objects
    black_book_1 - black_book
    white_yellow_mug_1 - white_yellow_mug
    butter_1 - butter
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    butter_1
    desk_1
  )

    (:init
    (On desk_caddy_1 study_table_desk_caddy_init_region)
    (On black_book_1 study_table_black_book_init_region)
    (On white_yellow_mug_1 study_table_white_yellow_mug_init_region)
    (On alphabet_soup_1 study_table_alphabet_soup_init_region)
    (On butter_1 desk_caddy_1_front_contain_region)
  )

  (:goal
    (And (On butter_1 desk_caddy_1_front_contain_region))
  )
)