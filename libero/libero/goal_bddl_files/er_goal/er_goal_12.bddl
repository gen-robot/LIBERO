(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the cream cheese on the stove)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.1900 -0.1900 0.2100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (cream_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1300 -0.0400 -0.0300 0.0400)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.4450 -0.0800 -0.1550 0.0800)
            )
          )
      )
      (moka_pot_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0450 -0.0700 0.1150 0.0700)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    cream_cheese_1 - cream_cheese
    chefmate_8_frypan_1 - chefmate_8_frypan
    moka_pot_1 - moka_pot
  )

  (:obj_of_interest
    cream_cheese_1
  )

    (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On chefmate_8_frypan_1 kitchen_table_chefmate_8_frypan_init_region)
    (On moka_pot_1 kitchen_table_moka_pot_init_region)
    (On cream_cheese_1 flat_stove_1_cook_region)
  )

  (:goal
    (And (On cream_cheese_1 flat_stove_1_cook_region))
  )
)