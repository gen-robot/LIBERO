(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the alphabet soup on the cabinet)
    (:regions
      (wooden_two_layer_shelf_init_region
          (:target study_table)
          (:ranges (
              (-0.0100 0.2700 0.0100 0.2900)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (top_region
          (:target wooden_two_layer_shelf_1)
      )
      (bottom_region
          (:target wooden_two_layer_shelf_1)
      )
      (alphabet_soup_init_region
          (:target study_table)
          (:ranges (
              (-0.0450 0.02 0.0450 0.10)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
  )

  (:obj_of_interest
    alphabet_soup_1
  )

    (:init
    (On wooden_two_layer_shelf_1 study_table_wooden_two_layer_shelf_init_region)
    (On alphabet_soup_1 wooden_two_layer_shelf_1_top_side)
  )

  (:goal
    (And (On alphabet_soup_1 wooden_two_layer_shelf_1_top_side))
  )
)