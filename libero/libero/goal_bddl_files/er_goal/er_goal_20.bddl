(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the alphabet soup on the stove)
    (:regions
      (stove_region
          (:target main_table)
          (:ranges (
              (-0.4200 0.2000 -0.4000 0.2200)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (alphabet_soup_init_region
          (:target main_table)
          (:ranges (
              (-0.0450 0.1050 0.0450 0.1950)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target main_table)
          (:ranges (
              (-0.2250 0.0050 -0.0750 0.1550)
            )
          )
      )
      (cream_cheese_init_region
          (:target main_table)
          (:ranges (
              (0.0300 -0.0400 0.1300 0.0400)
            )
          )
      )
      (wine_bottle_init_region
          (:target main_table)
          (:ranges (
              (0.0950 0.1250 0.1450 0.1750)
            )
          )
      )
      (plate_init_region
          (:target main_table)
          (:ranges (
              (-0.3950 -0.0950 -0.2650 0.0350)
            )
          )
      )
    )

  (:fixtures
    main_table - table
    flat_stove_1 - flat_stove
  )

  (:objects
    alphabet_soup_1 - alphabet_soup
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    wine_bottle_1 - wine_bottle
    plate_1 - plate
  )

  (:obj_of_interest
    alphabet_soup_1
  )

    (:init
    (On flat_stove_1 main_table_stove_region)
    (On akita_black_bowl_1 main_table_akita_black_bowl_init_region)
    (On cream_cheese_1 main_table_cream_cheese_init_region)
    (On wine_bottle_1 main_table_wine_bottle_init_region)
    (On plate_1 main_table_plate_init_region)
    (On alphabet_soup_1 flat_stove_1_cook_region)
  )

  (:goal
    (And (On alphabet_soup_1 flat_stove_1_cook_region))
  )
)