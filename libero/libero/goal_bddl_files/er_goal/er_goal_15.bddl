(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the orange juice on the stove)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.1900 -0.1900 0.2100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (orange_juice_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0350 -0.0650 0.1250 0.0650)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1550 -0.0750 -0.0050 0.0750)
            )
          )
      )
      (cream_cheese_init_region
          (:target kitchen_table)
          (:ranges (
              (0.0100 0.2000 0.1100 0.2800)
            )
          )
      )
      (wine_bottle_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.0250 0.1250 0.0250 0.1750)
            )
          )
      )
      (plate_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.3050 -0.0650 -0.1750 0.0650)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    orange_juice_1 - orange_juice
    akita_black_bowl_1 - akita_black_bowl
    cream_cheese_1 - cream_cheese
    wine_bottle_1 - wine_bottle
    plate_1 - plate
  )

  (:obj_of_interest
    orange_juice_1
  )

    (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On akita_black_bowl_1 kitchen_table_akita_black_bowl_init_region)
    (On cream_cheese_1 kitchen_table_cream_cheese_init_region)
    (On wine_bottle_1 kitchen_table_wine_bottle_init_region)
    (On plate_1 kitchen_table_plate_init_region)
    (On orange_juice_1 flat_stove_1_cook_region)
  )

  (:goal
    (And (On orange_juice_1 flat_stove_1_cook_region))
  )
)