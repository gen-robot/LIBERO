(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the ketchup on the stove)
    (:regions
      (flat_stove_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.2100 0.1900 -0.1900 0.2100)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (cook_region
          (:target flat_stove_1)
      )
      (ketchup_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.1150 -0.0550 -0.0450 0.0550)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    flat_stove_1 - flat_stove
  )

  (:objects
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    ketchup_1
  )

    (:init
    (On flat_stove_1 kitchen_table_flat_stove_init_region)
    (On ketchup_1 flat_stove_1_cook_region)
  )

  (:goal
    (And (On ketchup_1 flat_stove_1_cook_region))
  )
)