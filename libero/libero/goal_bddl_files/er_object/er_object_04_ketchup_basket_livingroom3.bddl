(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the ketchup and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.11 0.07999999999999999 0.11 0.28)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (ketchup_init_region
          (:target living_room_table)
          (:ranges (
              (-0.02 -0.14 0.02 -0.060000000000000005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    ketchup_1 - ketchup
  )

  (:obj_of_interest
    ketchup_1
    basket_1
  )

    (:init
    (On basket_1 living_room_table_basket_init_region)
    (On ketchup_1 basket_1_contain_region)
  )

  (:goal
    (And (In ketchup_1 basket_1_contain_region))
  )

)