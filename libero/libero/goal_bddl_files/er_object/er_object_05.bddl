(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the milk and place it in the basket)
    (:regions
      (basket_init_region
          (:target main_table)
          (:ranges (
              (0.055 -0.205 0.25 0.005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (milk_init_region
          (:target main_table)
          (:ranges (
              (-0.195 0.015000000000000003 -0.10499999999999998 0.14500000000000002)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

    (:fixtures
    main_table - table
  )

  (:objects
    basket_1 - basket
    milk_1 - milk
  )

  (:obj_of_interest
    milk_1
    basket_1
  )

    (:init
    (On basket_1 main_table_basket_init_region)
    (On milk_1 basket_1_contain_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region))
  )

)
