(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bbq sauce and place it in the basket)
    (:regions
      (wooden_two_layer_shelf_init_region
          (:target study_table)
          (:ranges (
              (-0.01 0.27 0.01 0.29000000000000004)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (top_side
          (:target wooden_two_layer_shelf_1)
      )
      (top_region
          (:target wooden_two_layer_shelf_1)
      )
      (bottom_region
          (:target wooden_two_layer_shelf_1)
      )
      (basket_init_region
          (:target study_table)
          (:ranges (
              (-0.165 -0.20 0.165 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (bbq_sauce_init_region
          (:target study_table)
          (:ranges (
              (-0.14 0.01 -0.060000000000000005 0.021)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    wooden_two_layer_shelf_1 - wooden_two_layer_shelf
  )

  (:objects
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

    (:init
    (On wooden_two_layer_shelf_1 study_table_wooden_two_layer_shelf_init_region)
    (On basket_1 study_table_basket_init_region)
    (On bbq_sauce_1 basket_1_contain_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)