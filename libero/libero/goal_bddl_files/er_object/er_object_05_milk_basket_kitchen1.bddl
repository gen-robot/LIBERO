(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the milk and place it in the basket)
    (:regions
      (wooden_cabinet_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.01 -0.31 0.01 -0.29)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (top_side
          (:target wooden_cabinet_1)
      )
      (top_region
          (:target wooden_cabinet_1)
      )
      (middle_region
          (:target wooden_cabinet_1)
      )
      (bottom_region
          (:target wooden_cabinet_1)
      )
      (basket_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.11 0.07999999999999999 0.11 0.28)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (milk_init_region
          (:target kitchen_table)
          (:ranges (
              (-0.21 -0.1 -0.15 0.0)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    kitchen_table - kitchen_table
    wooden_cabinet_1 - wooden_cabinet
  )

  (:objects
    basket_1 - basket
    milk_1 - milk
  )

  (:obj_of_interest
    milk_1
    basket_1
  )

    (:init
    (On wooden_cabinet_1 kitchen_table_wooden_cabinet_init_region)
    (On basket_1 kitchen_table_basket_init_region)
    (On milk_1 basket_1_contain_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region))
  )

)