(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the tomato sauce and place it in the basket)
    (:regions
      (basket_init_region
          (:target main_table)
          (:ranges (
              (-0.165 0.05 0.165 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (tomato_sauce_init_region
          (:target main_table)
          (:ranges (
              (-0.045 -0.07500000000000001 0.045 -0.015)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
  )

  (:obj_of_interest
    tomato_sauce_1
    basket_1
  )

    (:init
    (On basket_1 main_table_basket_init_region)
    (On tomato_sauce_1 basket_1_contain_region)
  )

  (:goal
    (And (In tomato_sauce_1 basket_1_contain_region))
  )

)
