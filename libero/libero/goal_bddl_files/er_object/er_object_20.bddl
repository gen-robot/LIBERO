(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the bbq sauce and place it in the basket)
    (:regions
      (wine_rack_region
          (:target main_table)
          (:ranges (
              (-0.27 -0.27 -0.25 -0.25)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (top_region
          (:target wine_rack_1)
      )
      (basket_init_region
          (:target main_table)
          (:ranges (
              (0.05 -0.25 0.25 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (bbq_sauce_init_region
          (:target main_table)
          (:ranges (
              (-0.25 0.2 -0.1 0.3)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (glazed_rim_porcelain_ramekin_init_region
          (:target main_table)
          (:ranges (
              (0.14500000000000002 0.01 0.255 0.025000000000000005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target main_table)
          (:ranges (
              (-0.265 0.05 -0.05 0.155)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
    wine_rack_1 - wine_rack
  )

  (:objects
    basket_1 - basket
    bbq_sauce_1 - bbq_sauce
    glazed_rim_porcelain_ramekin_1 - glazed_rim_porcelain_ramekin
    plate_1 - plate
  )

  (:obj_of_interest
    bbq_sauce_1
    basket_1
  )

    (:init
    (On wine_rack_1 main_table_wine_rack_region)
    (On basket_1 main_table_basket_init_region)
    (On glazed_rim_porcelain_ramekin_1 main_table_glazed_rim_porcelain_ramekin_init_region)
    (On plate_1 main_table_plate_init_region)
    (On bbq_sauce_1 basket_1_contain_region)
  )

  (:goal
    (And (In bbq_sauce_1 basket_1_contain_region))
  )

)
