(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the salad dressing and place it in the basket)
    (:regions
      (basket_init_region
          (:target main_table)
          (:ranges (
              (-0.165 0.05 0.165 0.2)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (salad_dressing_init_region
          (:target main_table)
          (:ranges (
              (-0.04 -0.085 0.04 0.025000000000000005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    basket_1 - basket
    salad_dressing_1 - salad_dressing
  )

  (:obj_of_interest
    salad_dressing_1
    basket_1
  )

    (:init
    (On basket_1 main_table_basket_init_region)
    (On salad_dressing_1 basket_1_contain_region)
  )

  (:goal
    (And (In salad_dressing_1 basket_1_contain_region))
  )

)
