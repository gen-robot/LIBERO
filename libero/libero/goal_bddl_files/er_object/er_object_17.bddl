(define (problem LIBERO_Study_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the tomato sauce and place it in the basket)
    (:regions
      (desk_caddy_init_region
          (:target study_table)
          (:ranges (
              (-0.21000000000000002 -0.15000000000000002 -0.19 -0.13)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (desk_caddy_right_region
          (:target study_table)
          (:ranges (
              (-0.25 0.09999999999999999 -0.15000000000000002 0.2)
            )
          )
          (:yaw_rotation (
              (3.141592653589793 3.141592653589793)
            )
          )
      )
      (right_contain_region
          (:target desk_caddy_1)
      )
      (left_contain_region
          (:target desk_caddy_1)
      )
      (back_contain_region
          (:target desk_caddy_1)
      )
      (front_contain_region
          (:target desk_caddy_1)
      )
      (basket_init_region
          (:target study_table)
          (:ranges (
              (-0.02 0.15 0.25 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (tomato_sauce_init_region
          (:target study_table)
          (:ranges (
              (-0.1 -0.2 0.2 -0.1)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (akita_black_bowl_init_region
          (:target study_table)
          (:ranges (
              (0.125 -0.0500000000000001 0.25 0.045000000000000005)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (plate_init_region
          (:target study_table)
          (:ranges (
              (-0.265 0.2 -0.2 0.25)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    study_table - study_table
    desk_caddy_1 - desk_caddy
  )

  (:objects
    basket_1 - basket
    tomato_sauce_1 - tomato_sauce
    akita_black_bowl_1 - akita_black_bowl
    plate_1 - plate
  )

  (:obj_of_interest
    tomato_sauce_1
    basket_1
  )

    (:init
    (On desk_caddy_1 study_table_desk_caddy_init_region)
    (On basket_1 study_table_basket_init_region)
    (On akita_black_bowl_1 study_table_akita_black_bowl_init_region)
    (On plate_1 study_table_plate_init_region)
    (On tomato_sauce_1 basket_1_contain_region)
  )

  (:goal
    (And (In tomato_sauce_1 basket_1_contain_region))
  )

)