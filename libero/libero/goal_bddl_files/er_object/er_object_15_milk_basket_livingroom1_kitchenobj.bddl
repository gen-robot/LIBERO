(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the milk and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.11 0.07999999999999999 0.11 0.28)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (milk_init_region
          (:target living_room_table)
          (:ranges (
              (-0.03 -0.15000000000000002 0.03 -0.05)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (chefmate_8_frypan_init_region
          (:target living_room_table)
          (:ranges (
              (-0.36 -0.21 -0.07999999999999999 -0.09)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    milk_1 - milk
    chefmate_8_frypan_1 - chefmate_8_frypan
  )

  (:obj_of_interest
    milk_1
    basket_1
  )

    (:init
    (On basket_1 living_room_table_basket_init_region)
    (On chefmate_8_frypan_1 living_room_table_chefmate_8_frypan_init_region)
    (On milk_1 basket_1_contain_region)
  )

  (:goal
    (And (In milk_1 basket_1_contain_region))
  )

)