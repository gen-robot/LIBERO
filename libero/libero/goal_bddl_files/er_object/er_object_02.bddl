(define (problem LIBERO_Living_Room_Tabletop_Manipulation)
  (:domain robosuite)
  (:language pick up the butter and place it in the basket)
    (:regions
      (basket_init_region
          (:target living_room_table)
          (:ranges (
              (-0.165 -0.02 0.165 0.275)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
      (butter_init_region
          (:target living_room_table)
          (:ranges (
              (-0.055 -0.185 0.055 -0.11499999999999999)
            )
          )
          (:yaw_rotation (
              (0.0 0.0)
            )
          )
      )
    )

  (:fixtures
    living_room_table - living_room_table
  )

  (:objects
    basket_1 - basket
    butter_1 - butter
  )

  (:obj_of_interest
    butter_1
    basket_1
  )

    (:init
    (On basket_1 living_room_table_basket_init_region)
    (On butter_1 basket_1_contain_region)
  )

  (:goal
    (And (In butter_1 basket_1_contain_region))
  )

)