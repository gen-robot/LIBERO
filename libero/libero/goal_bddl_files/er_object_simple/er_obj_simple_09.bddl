(define (problem LIBERO_Tabletop_Manipulation)
  (:domain robosuite)
  (:language Pick the wine bottle and place it in the basket)
    (:regions
      (bin_region
          (:target main_table)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target main_table)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
      (other_object_region_0
          (:target main_table)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_1
          (:target main_table)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
      )
      (other_object_region_2
          (:target main_table)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
      )
      (other_object_region_3
          (:target main_table)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
      )
      (other_object_region_4
          (:target main_table)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    main_table - table
  )

  (:objects
    wine_bottle_1 - wine_bottle
    basket_1 - basket
    akita_black_bowl_1 - akita_black_bowl
    black_book_1 - black_book
    white_yellow_mug_1 - white_yellow_mug
    alphabet_soup_1 - alphabet_soup
    white_bowl_1 - white_bowl
  )

  (:obj_of_interest
    wine_bottle_1
    basket_1
  )

    (:init
    (On akita_black_bowl_1 main_table_other_object_region_0)
    (On black_book_1 main_table_other_object_region_1)
    (On white_yellow_mug_1 main_table_other_object_region_2)
    (On alphabet_soup_1 main_table_other_object_region_3)
    (On white_bowl_1 main_table_other_object_region_4)
    (On basket_1 main_table_bin_region)
    (On wine_bottle_1 basket_1_contain_region)
  )

  (:goal
    (And (In wine_bottle_1 basket_1_contain_region))
  )

)
