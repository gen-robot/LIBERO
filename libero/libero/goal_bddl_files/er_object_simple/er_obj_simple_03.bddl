(define (problem LIBERO_Floor_Manipulation)
  (:domain robosuite)
  (:language Pick the white and yellow mug and place it in the basket)
    (:regions
      (bin_region
          (:target floor)
          (:ranges (
              (-0.01 0.25 0.01 0.27)
            )
          )
      )
      (target_object_region
          (:target floor)
          (:ranges (
              (-0.145 -0.265 -0.095 -0.215)
            )
          )
      )
      (other_object_region_0
          (:target floor)
          (:ranges (
              (0.025 -0.125 0.07500000000000001 -0.07500000000000001)
            )
          )
      )
      (other_object_region_1
          (:target floor)
          (:ranges (
              (-0.175 0.034999999999999996 -0.125 0.08499999999999999)
            )
          )
      )
      (other_object_region_2
          (:target floor)
          (:ranges (
              (0.07500000000000001 -0.225 0.125 -0.17500000000000002)
            )
          )
      )
      (other_object_region_3
          (:target floor)
          (:ranges (
              (0.125 0.0049999999999999975 0.175 0.055)
            )
          )
      )
      (other_object_region_4
          (:target floor)
          (:ranges (
              (-0.225 -0.10500000000000001 -0.17500000000000002 -0.055)
            )
          )
      )
      (contain_region
          (:target basket_1)
      )
    )

  (:fixtures
    floor - floor
  )

  (:objects
    white_yellow_mug_1 - white_yellow_mug
    basket_1 - basket
    akita_black_bowl_1 - akita_black_bowl
    wine_bottle_1 - wine_bottle
    yellow_book_1 - yellow_book
    black_book_1 - black_book
    plate_1 - plate
  )

  (:obj_of_interest
    white_yellow_mug_1
    basket_1
  )

    (:init
    (On akita_black_bowl_1 floor_other_object_region_0)
    (On wine_bottle_1 floor_other_object_region_1)
    (On yellow_book_1 floor_other_object_region_2)
    (On black_book_1 floor_other_object_region_3)
    (On plate_1 floor_other_object_region_4)
    (On basket_1 floor_bin_region)
    (On white_yellow_mug_1 basket_1_contain_region)
  )

  (:goal
    (And (In white_yellow_mug_1 basket_1_contain_region))
  )

)
